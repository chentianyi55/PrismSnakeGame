<UserControl x:Class="PrismSnakeGame.Views.SnakeGame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismSnakeGame.ViewModels"
             xmlns:vm="clr-namespace:PrismSnakeGame.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 坐标转换器：网格坐标转为像素 -->
        <local:PointToPositionConverter x:Key="PointToPositionConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Canvas Width="400" Height="400" Background="LightGray">
            <!-- 绘制蛇 -->
            <ItemsControl ItemsSource="{Binding SnakePositions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="20" Height="20" Fill="Green">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="{Binding X, Converter={StaticResource PointToPositionConverter}}" 
                                                    Y="{Binding Y, Converter={StaticResource PointToPositionConverter}}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 绘制食物 -->
            <Ellipse Width="20" Height="20" Fill="Red">
                <Ellipse.RenderTransform>
                    <TranslateTransform X="{Binding FoodPosition.X, Converter={StaticResource PointToPositionConverter}}" 
                                        Y="{Binding FoodPosition.Y,Converter={StaticResource PointToPositionConverter}}"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <!-- 队列 -->
        <TextBlock Text="{Binding QueueCount, StringFormat='Queue Count: {0}'}"
           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" FontSize="16"/>
        <!-- 分数 -->
        <TextBlock Text="{Binding Score, StringFormat='Score: {0}'}" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" FontSize="16"/>
        <!-- 游戏结束提示 -->
        <TextBlock Text="Game Over" 
                   Visibility="{Binding IsGameOver, Converter={StaticResource BooleanToVisibilityConverter}}" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Foreground="Red"/>
        <!-- 开始按钮 -->
        <Button Content="Start Game" Command="{Binding StartGameCommand}" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
    </Grid>
</UserControl>